<%# Source: https://docs.fulcrumapp.com/docs/functions#query %>
<%# Purpose: join a repeatable table to its parent record. %>
<%# Repeatable rows live in their own table and carry _parent_id. %>

<% const recordId = String(record.id || '').replace(/[^a-zA-Z0-9_-]/g, ''); %>
<% const itemResults = QUERY(
  `SELECT r.*
   FROM "Work Orders/line_items" r
   WHERE r._parent_id = '${recordId}'`,
  { format: 'json' }
); %>
<% const items = itemResults.rows; %>
