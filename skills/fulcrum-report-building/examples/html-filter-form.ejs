<%# Source: https://docs.fulcrumapp.com/docs/reports-introduction %>
<%# Fragment: paste into a Report Template; this is not a standalone template. %>
<%# Purpose: an HTML-output report that re-submits to its own URL. %>
<%# Pair with params-date-range.ejs, which validates the submitted values. %>
<%# The paired fragment renders its default 90-day window before any values
    are submitted, then uses the submitted values on the next request. %>

<form method="GET">
  <label>Start Date: <input type="date" name="start_date" value="<%= startDate %>"></label>
  <label>End Date: <input type="date" name="end_date" value="<%= endDate %>"></label>
  <button type="submit">Generate</button>
</form>
