<%# Source: https://docs.fulcrumapp.com/docs/functions#query %>
<%# Fragment: paste into a Report Template; this is not a standalone template. %>
<%# Purpose: join a repeatable table to its parent record. %>
<%# Repeatable rows live in their own table and carry _parent_id. %>
<%# The record ID is encoded in the gap it reaches SQL through; `('' + value)` %>
<%# converts without naming `String`, which a template could rebind. %>

<% const itemResults = QUERY(
  `SELECT r._child_record_id, r._created_at
   FROM "Work Orders/line_items" r
   WHERE r._parent_id = '${('' + record.id).replace(/[^A-Za-z0-9_-]/g, '')}'
   ORDER BY r._created_at DESC
   LIMIT 100`,
  { format: 'json' }
); %>
<% const MAX_ITEMS = 100; %>
<% const resultItems = itemResults.rows; %>
<% const hasMoreItems = resultItems.length === MAX_ITEMS; %>
<% const items = hasMoreItems ? resultItems.slice(0, MAX_ITEMS) : resultItems; %>
<table class="report-table">
  <thead>
    <tr>
      <th scope="col">Record</th>
      <th scope="col">Created</th>
    </tr>
  </thead>
  <tbody>
    <% if (items.length === 0) { %>
      <tr>
        <td colspan="2">No line items found.</td>
      </tr>
    <% } else { %>
      <% items.forEach(function (item) { %>
        <tr>
          <td><%= item._child_record_id %></td>
          <td><%= item._created_at %></td>
        </tr>
      <% }); %>
    <% } %>
    <% if (hasMoreItems) { %>
      <tr>
        <td colspan="2" class="report-warning">
          Showing up to 100 line items. Because the Query API caps each response
          at 100 rows, this result may be partial; narrow the query or use SQL
          LIMIT/OFFSET or keyset pagination for a complete result.
        </td>
      </tr>
    <% } %>
  </tbody>
</table>
