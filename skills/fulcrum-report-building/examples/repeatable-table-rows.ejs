<%# Source: https://docs.fulcrumapp.com/docs/functions#render %>
<%# Fragment: paste into a Report Template; this is not a standalone template. %>
<%# Purpose: render repeatable child entries as table rows. %>
<%# A repeatable form value exposes `items`; each item has its own formValues. %>
<%# A <tr> is only valid inside a table, so the rows are wrapped in one here. %>

<% const observations = record.formValues.find('observations'); %>
<% const observationItems = observations ? observations.items : []; %>
<table class="report-table">
  <thead>
    <tr>
      <th scope="col">Species</th>
      <th scope="col">Count</th>
    </tr>
  </thead>
  <tbody>
    <% if (observationItems.length === 0) { %>
      <tr>
        <td colspan="2">No observations recorded.</td>
      </tr>
    <% } else { %>
      <% observationItems.forEach(function (observation) { %>
        <% const species = observation.formValues.find('species'); %>
        <% const count = observation.formValues.find('count'); %>
        <tr>
          <td><%= species ? species.displayValue : '' %></td>
          <td><%= count ? count.value : '' %></td>
        </tr>
      <% }); %>
    <% } %>
  </tbody>
</table>
